local player = Players.LocalPlayer

-- พิกัดเป้าหมายที่คุณต้องการ
local targetPosition = Vector3.new(547.18, 71.13, -365.94)

-- สร้าง GUI ปุ่มกด (วางไว้ฝั่งขวา ไม่ทับของเดิม)
local screenGui = Instance.new("ScreenGui")
