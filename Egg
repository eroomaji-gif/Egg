btnWalk.Position = UDim2.new(1, -250, 0, 380) -- ฝั่งขวา ถัดลงมาจากปุ่มก่อนหน้า
btnWalk.BackgroundColor3 = Color3.fromRGB(241, 196, 15)
btnWalk.TextColor3 = Color3.fromRGB(0, 0, 0)
btnWalk.TextSize = 14
btnWalk.Font = Enum.Font.GothamBold
btnWalk.Text = "วิ่งไปที่พิกัด (ธรรมชาติสุดๆ)"
btnWalk.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = btnWalk

-- ฟังก์ชันสั่งให้ตัวละครเดินไปหาเป้าหมายเองแบบธรรมชาติ
local function walkToTarget()
	local char = player.Character
	if not char then return end
	local humanoid = char:FindFirstChild("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	
	if humanoid and hrp then
		-- สั่งให้ Humanoid เดินไปที่พิกัดเป้าหมาย (ระบบเกมจะคำนวณการเดินและสิ่งกีดขวางให้เอง)
		humanoid:MoveTo(targetPosition)
		
		-- (ทางเลือกเสริม) เช็คว่าเดินไปถึงใกล้ๆ เป้าหมายหรือยัง
		local connection
		connection = game:GetService("RunService").Stepped:Connect(function()
			if not char or not hrp or not humanoid then 
				if connection then connection:Disconnect() end
				return
			end
			
			-- ถ้าระยะห่างจากเป้าหมายเหลือน้อยกว่า 3 สตั๊ด ถือว่าถึงแล้ว
			local distance = (hrp.Position - targetPosition).Magnitude
			if distance < 3 then
				humanoid:MoveTo(hrp.Position) -- สั่งให้หยุดเดินตรงนั้น
				if connection then connection:Disconnect() end
			end
		end)
	end
end

btnWalk.MouseButton1Click:Connect(walkToTarget)
