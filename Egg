local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

-- พิกัดเป้าหมายที่คุณต้องการวิ่งไป
local targetPosition = Vector3.new(4797.52, 71.13, -330.78)

-- สร้าง GUI ปุ่มกดฝั่งขวา (ไม่ทับของเดิม)
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "StableWalkGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0, 240, 0, 50)
btn.Position = UDim2.new(1, -270, 0, 260)
btn.BackgroundColor3 = Color3.fromRGB(39, 174, 96)
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.TextSize = 14
btn.Font = Enum.Font.GothamBold
btn.Text = "วิ่งไปพิกัด (แบบเสถียร): OFF"
btn.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = btn

local isWalking = false
local walkConnection = nil

btn.MouseButton1Click:Connect(function()
	isWalking = not isWalking
	local char = player.Character
	local humanoid = char and char:FindFirstChild("Humanoid")
	
	if isWalking then
		btn.Text = "วิ่งไปพิกัด (แบบเสถียร): ON"
		btn.BackgroundColor3 = Color3.fromRGB(41, 128, 185)
		
		if humanoid then
			-- สั่งเดินไปหาเป้าหมายครั้งแรก
			humanoid:MoveTo(targetPosition)
			
			-- ใช้ข้อความคอยรีเฟรชคำสั่ง MoveTo ทุกๆ 3 วินาที เพื่อป้องกันอาการ Time-out ของ Roblox
			if walkConnection then walkConnection:Disconnect() end
			walkConnection = RunService.Heartbeat:Connect(function()
				if not isWalking then 
					if walkConnection then walkConnection:Disconnect() end
					return
				end
				
				local currentChars = player.Character
				if not currentChars then return end
				local hrp = currentChars:FindFirstChild("HumanoidRootPart")
				local hum = currentChars:FindFirstChild("Humanoid")
				
				if hrp and hum then
					local dist = (Vector3.new(targetPosition.X, hrp.Position.Y, targetPosition.Z) - hrp.Position).Magnitude
					
					-- ถ้าถึงเป้าหมายแล้ว ให้ปิดระบบอัตโนมัติ
					if dist < 4 then
						hum:MoveTo(hrp.Position) -- สั่งหยุด
						isWalking = false
						btn.Text = "วิ่งไปพิกัด: ถึงแล้ว!"
						btn.BackgroundColor3 = Color3.fromRGB(39, 174, 96)
						if walkConnection then walkConnection:Disconnect() end
						return
					end
					
					-- รีเฟรชคำสั่ง MoveTo ทุกๆ 1.5 วินาที เพื่อให้ตัวละครวิ่งยาวๆ ไม่หยุดกลางทาง
					if math.random() < 0.05 then 
						hum:MoveTo(targetPosition)
					end
				end
			end)
		end
	else
		isWalking = false
		btn.Text = "วิ่งไปพิกัด (แบบเสถียร): OFF"
		btn.BackgroundColor3 = Color3.fromRGB(39, 174, 96)
		
		if walkConnection then walkConnection:Disconnect() end
		if humanoid then
			humanoid:MoveTo(player.Character.HumanoidRootPart.Position) -- สั่งหยุดเดิน
		end
	end
end)



local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

-- พิกัดเป้าหมายที่คุณต้องการล็อกตัวไว้
local targetCFrame = CFrame.new(547.18, 71.13, -365.94)

-- 1. สร้างปุ่มเปิด-ปิดระบบสงครามยื้อพิกัด (ย้ายตำแหน่งมาฝั่งขวา ไม่ทับของเดิม)
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "SafeTugOfWarGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0, 240, 0, 50)
btn.Position = UDim2.new(1, -270, 0, 140)
btn.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.TextSize = 14
btn.Font = Enum.Font.GothamBold
btn.Text = "ยื้อพิกัดเซฟโซน: OFF"
btn.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = btn

local isTugActive = false

btn.MouseButton1Click:Connect(function()
	isTugActive = not isTugActive
	
	local char = player.Character
	local humanoid = char and char:FindFirstChild("Humanoid")
	
	if isTugActive then
		btn.Text = "ยื้อพิกัดเซฟโซน: ON (หลบรีเซิร์ฟ)"
		btn.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
	else
		btn.Text = "ยื้อพิกัดเซฟโซน: OFF"
		btn.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
		
		-- คืนค่าสถานะปกติ
		if humanoid then
			pcall(function()
				humanoid.PlatformStand = false
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end)
		end
	end
end)

-- 2. ระบบยื้อพิกัดแบบปลอดภัย (ใช้ Heartbeat และไม่บังคับเปลี่ยน State เป็น Physics พร่ำเพรื่อ)
local frameCounter = 0
RunService.Heartbeat:Connect(function()
	if not isTugActive then return end
	
	local char = player.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local humanoid = char:FindFirstChild("Humanoid")
	
	if hrp and humanoid then
		frameCounter = frameCounter + 1
		
		-- ล็อกพิกัดแบบเนียนๆ สลับเฟรมเพื่อไม่ให้แอนตี้ชีทรัวรีเซ็ตตัว
		hrp.CFrame = targetCFrame
		hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		
		-- ป้องกันไม่ให้ตัวละครล้มพับหรือติดสถานะทรุด
		if humanoid.PlatformStand == false then
			humanoid.PlatformStand = true
		end
	end
end)



local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- พิกัดเป้าหมายที่คุณต้องการ
local targetPosition = Vector3.new(547.18, 71.13, -365.94)

-- สร้าง GUI ปุ่มกด (วางไว้ฝั่งขวา ไม่ทับของเดิม)
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "AutoWalkGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

local btnWalk = Instance.new("TextButton")
btnWalk.Size = UDim2.new(0, 220, 0, 50)
btnWalk.Position = UDim2.new(1, -250, 0, 380) -- ฝั่งขวา ถัดลงมาจากปุ่มก่อนหน้า
btnWalk.BackgroundColor3 = Color3.fromRGB(241, 196, 15)
btnWalk.TextColor3 = Color3.fromRGB(0, 0, 0)
btnWalk.TextSize = 14
btnWalk.Font = Enum.Font.GothamBold
btnWalk.Text = "วิ่งไปที่พิกัด (ธรรมชาติสุดๆ)"
btnWalk.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = btnWalk

-- ฟังก์ชันสั่งให้ตัวละครเดินไปหาเป้าหมายเองแบบธรรมชาติ
local function walkToTarget()
	local char = player.Character
	if not char then return end
	local humanoid = char:FindFirstChild("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	
	if humanoid and hrp then
		-- สั่งให้ Humanoid เดินไปที่พิกัดเป้าหมาย (ระบบเกมจะคำนวณการเดินและสิ่งกีดขวางให้เอง)
		humanoid:MoveTo(targetPosition)
		
		-- (ทางเลือกเสริม) เช็คว่าเดินไปถึงใกล้ๆ เป้าหมายหรือยัง
		local connection
		connection = game:GetService("RunService").Stepped:Connect(function()
			if not char or not hrp or not humanoid then 
				if connection then connection:Disconnect() end
				return
			end
			
			-- ถ้าระยะห่างจากเป้าหมายเหลือน้อยกว่า 3 สตั๊ด ถือว่าถึงแล้ว
			local distance = (hrp.Position - targetPosition).Magnitude
			if distance < 3 then
				humanoid:MoveTo(hrp.Position) -- สั่งให้หยุดเดินตรงนั้น
				if connection then connection:Disconnect() end
			end
		end)
	end
end

btnWalk.MouseButton1Click:Connect(walkToTarget)
