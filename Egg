-- ลูปเช็คและสร้างพื้นใต้เท้าแบบเรียลไทม์
RunService.RenderStepped:Connect(function()
    if getgenv().AirWalkActive then
        pcall(function()
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local rootPart = char.HumanoidRootPart
                
                -- เช็คว่าใต้เท้ามีพื้นรองรับอยู่จริงไหม (ยิง Raycast ลงข้างล่าง)
                local raycastParams = RaycastParams.new()
                raycastParams.FilterDescendantsInstances = {char}
                raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                
                -- ยิงลงไป 4 หน่วย
                local raycastResult = workspace:Raycast(rootPart.Position, Vector3.new(0, -4.5, 0), raycastParams)
                
                -- ถ้าไม่มีพื้นรองรับ (แปลว่ากำลังอยู่กลางอากาศ หรือเดินตกขอบเหว)
                if not raycastResult then
                    if not currentPlatform or not currentPlatform.Parent then
                        -- สร้างแผ่นพื้นรองรับใต้เท้าทันที
                        currentPlatform = Instance.new("Part")
                        currentPlatform.Name = "AirWalkPlatform"
                        currentPlatform.Size = Vector3.new(4, 0.5, 4) -- ขนาดแผ่นพื้น
                        currentPlatform.Anchored = true
                        currentPlatform.CanCollide = true
                        currentPlatform.Transparency = 0.5 -- ตั้งเป็น 0.5 เพื่อให้มองเห็นลางๆ (หรือแก้เป็น 1 ถ้าไม่อยากให้ใครเห็น)
                        currentPlatform.BrickColor = BrickColor.new("Institutional white")
                        currentPlatform.Parent = workspace
                    end
                    -- วางตำแหน่งแผ่นพื้นไว้ใต้เท้าพอดีเป๊ะ
                    currentPlatform.Position = rootPart.Position - Vector3.new(0, 3.5, 0)
                else
                    -- ถ้ามีพื้นปกติแล้ว ให้ลบแผ่นพื้นชั่วคราวทิ้ง จะได้เดินบนพื้นเกมตามปกติ
                    if currentPlatform then
                        currentPlatform:Destroy()
                        currentPlatform = nil
                    end
                end
            end
        end)
    else
        if currentPlatform then
            currentPlatform:Destroy()
            currentPlatform = nil
        end
    end
end)
