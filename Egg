local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local localPlayer = Players.LocalPlayer

local targetPosition = Vector3.new(5662.85, 70.28, -328.14) -- พิกัดเป้าหมาย
local walkConnection = nil
local walkSwitch = nil
local lastMoveCall = 0

walkSwitch = createSwitchButton(ContentContainer, "⚡ วิ่งไปด่านท้าย", false, function(isActive)
    local char = localPlayer.Character
    local humanoid = char and char:FindFirstChild("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if isActive then
        if humanoid and hrp then
            humanoid:MoveTo(targetPosition)
            lastMoveCall = tick()
            
            if walkConnection then walkConnection:Disconnect() end
            walkConnection = RunService.Heartbeat:Connect(function()
                local currentChars = localPlayer.Character
                if not currentChars then return end
                local curHrp = currentChars:FindFirstChild("HumanoidRootPart")
                local curHum = currentChars:FindFirstChild("Humanoid")
                
                if curHrp and curHum then
                    local dist = (Vector3.new(targetPosition.X, curHrp.Position.Y, targetPosition.Z) - curHrp.Position).Magnitude
                    
                    -- ถ้าถึงเป้าหมายแล้ว ให้หยุดและปิดสวิตช์เอง
                    if dist < 4 then
                        curHum:MoveTo(curHrp.Position)
                        if walkConnection then walkConnection:Disconnect() end
                        walkConnection = nil
                        if walkSwitch then
                            walkSwitch.SetState(false, false)
                        end
                        return
                    end
                    
                    -- สั่งรีเฟรช MoveTo ทุกๆ 1.5 วินาที ไม่ให้ Time-out และเดินต่อยาวๆ จนถึง
                    if tick() - lastMoveCall >= 1.5 then
                        curHum:MoveTo(targetPosition)
                        lastMoveCall = tick()
                    end
                end
            end)
        end
    else
        if walkConnection then 
            walkConnection:Disconnect() 
            walkConnection = nil
        end
        if humanoid and hrp then
            humanoid:MoveTo(hrp.Position)
        end
    end
end)










